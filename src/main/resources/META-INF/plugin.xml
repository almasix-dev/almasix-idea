<idea-plugin require-restart="true">
  <id>com.almasix.ide</id>
  <name>Almasix</name>
  <vendor url="https://github.com/almasix-dev/ide-support">Almasix</vendor>
  <description><![CDATA[
    <p><b>Almasix Idea</b> — native JetBrains support for Almasix:</p>
    <ul>
      <li>Prism (<code>.prism.html</code>) — HTML/CSS colors with Prism overlays</li>
      <li>Deep completions + unknown-symbol annotations (routes, views, config,
          translations, gates, validation, Articulate relations, components, …)</li>
      <li>Symbol index via <code>smith ide:index --json</code> (no LSP4IJ)</li>
      <li>Smith run configuration templates</li>
    </ul>
    <p>Install from the JetBrains Marketplace, or sideload a zip from
    <a href="https://github.com/almasix-dev/ide-support/releases">GitHub Releases</a>.</p>
    <p><b>Note:</b> installing, updating, or removing this plugin requires an IDE restart.</p>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.xml</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
        name="Prism"
        implementationClass="com.almasix.ide.PrismFileType"
        fieldName="INSTANCE"
        language="Prism"
        extensions="prism.html"
        patterns="*.prism.html"/>

    <fileTypeOverrider implementation="com.almasix.ide.PrismFileTypeOverrider"/>
    <fileTypeDetector implementation="com.almasix.ide.PrismFileTypeDetector" order="first"/>

    <lang.parserDefinition language="Prism" implementationClass="com.almasix.ide.PrismParserDefinition"/>
    <lang.fileViewProviderFactory language="Prism" implementationClass="com.almasix.ide.PrismFileViewProviderFactory"/>

    <lang.syntaxHighlighterFactory language="Prism" implementationClass="com.almasix.ide.PrismSyntaxHighlighterFactory"/>
    <editorHighlighterProvider filetype="Prism" implementationClass="com.almasix.ide.PrismEditorHighlighterProvider"/>

    <typedHandler implementation="com.almasix.ide.PrismTypedHandler"/>
    <lang.braceMatcher language="Prism" implementationClass="com.almasix.ide.PrismBraceMatcher"/>

    <configurationType implementation="com.almasix.ide.SmithConfigurationType"/>

    <completion.contributor language="any" implementationClass="com.almasix.ide.AlmasixCompletionContributor"/>
    <annotator language="any" implementationClass="com.almasix.ide.AlmasixAnnotator"/>
    <gotoDeclarationHandler implementation="com.almasix.ide.AlmasixGotoDeclarationHandler"/>
  </extensions>

  <actions>
    <!-- popup=true so Tools gets a real "Almasix" submenu (false inlined
         children and made the group easy to miss). -->
    <group id="Almasix.Menu" text="Almasix" description="Almasix Idea" popup="true">
      <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Almasix.RebuildIndex"
              class="com.almasix.ide.RebuildIndexAction"
              text="Rebuild Index"
              description="Rebuild the Almasix symbol index (smith ide:index --json)"/>
    </group>
  </actions>

  <applicationListeners>
    <listener
        class="com.almasix.ide.AlmasixPluginListener"
        topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    <listener
        class="com.almasix.ide.AlmasixIndexWatcher"
        topic="com.intellij.openapi.project.ProjectManagerListener"/>
  </applicationListeners>
</idea-plugin>
